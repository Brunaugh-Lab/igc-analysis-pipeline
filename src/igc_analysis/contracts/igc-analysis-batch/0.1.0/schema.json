{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Brunaugh-Lab/igc-analysis-pipeline/igc-analysis-batch/0.1.0/schema.json",
  "title": "IGC analysis batch manifest 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "bundles", "jobs"],
  "properties": {
    "schema_version": {"const": "igc-analysis-batch/0.1.0"},
    "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundle_id", "path"],
        "properties": {
          "bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "analysis", "bundle_ids"],
        "properties": {
          "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "analysis": {"enum": ["bet", "dispersive", "acid_base", "full_peak"]},
          "bundle_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "settings": {"type": "object"}
        }
      }
    }
  }
}
